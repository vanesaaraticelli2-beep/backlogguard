# Copiar a .env y completar. No versionar .env ni claves reales.

# Modo de ejecución: 0 = sin llamadas de red (tests y demo con proveedor falso), 1 = LLM real.
LIVE_MODE=0

# Claves de los proveedores de LLM (solo necesarias con LIVE_MODE=1).
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Azure DevOps: simulated por defecto. El modo real con PAT es solo para desarrollo local.
AZDO_MODE=simulated
AZDO_ORG_URL=https://tp-itba.visualstudio.com/
AZDO_PROJECT=TP-ITBA
# Opcional: endpoint MCP remoto (Streamable HTTP). Vacío = cliente/servidor en proceso.
AZDO_MCP_ENDPOINT=
# Ingresar el PAT solo en .env local/secret store. No pegarlo en el chat ni versionarlo.
AZDO_TOKEN=
# Opcionales: si se dejan vacíos se descubren los tipos disponibles del proceso.
AZDO_EPIC_TYPE=
AZDO_STORY_TYPE=
AZDO_TASK_TYPE=

# Persistencia: memoria del proyecto (SQLite) y snapshots del tablero (JSON).
BACKLOGGUARD_DB_PATH=data/backlogguard.sqlite
BACKLOGGUARD_CHECKPOINT_PATH=data/checkpoints.json
